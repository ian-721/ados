{
  "manifest_version": 3,
  "name": "ADOS Local Public Fixture",
  "version": "0.1.1",
  "description": "Owner-selected ChatGPT capture to authenticated local pre-dispatch intake.",
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open ADOS Local"
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "capture-profile.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
